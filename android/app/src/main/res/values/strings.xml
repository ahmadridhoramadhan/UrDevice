    <!-- Onboarding -->
    <string name="ob_welcome">Welcome to UrDevice</string>
    <string name="ob_welcome_body">Connect your own devices on one local network. No account and no cloud server.</string>
    <string name="ob_name">Name this device</string>
    <string name="ob_name_hint">Other devices see this name. You can change it later in Settings.</string>
    <string name="ob_safe">Safe and local</string>
    <string name="ob_safe_body">Your devices talk directly on the same network. There is no server, and every connection is encrypted with this device\'s own key.</string>
    <string name="ob_safe_key">The key for this device is ready and protected by Android Keystore. Its Device ID:</string>
    <string name="ob_safe_check">Check this ID on the other device when you pair.</string>
    <string name="ob_perms">Permissions for other devices</string>
    <string name="ob_perms_body">Choose what your other devices may do here. This applies to every paired device. You can change it later on This device.</string>
