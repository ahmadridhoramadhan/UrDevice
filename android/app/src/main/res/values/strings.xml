    <string name="ob_paired_body">Both devices are connected. They reconnect on their own when they are on the same network.</string>
    <string name="ob_open">Open UrDevice</string>

    <!-- OS permission explanations (R15.2) -->
    <string name="why_notifications_title">Allow notifications</string>
    <string name="why_notifications_body">UrDevice shows a notification while it runs, and asks you there when another device wants to use a feature set to Always Ask.</string>
    <string name="why_camera_title">Allow the camera</string>
    <string name="why_camera_body">The camera is used only to scan the pairing QR code on your other device. Frames stay on the phone and are never saved or sent.</string>
    <string name="why_network_title">Allow nearby devices</string>
    <string name="why_network_body">UrDevice needs access to your local network to find and connect to your own devices. Nothing goes to the internet.</string>
    <string name="grant">Allow</string>
    <string name="not_now">Not now</string>
