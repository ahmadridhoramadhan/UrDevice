// Android gallery (#17): the desktop feature view.
// Rust side: src/features/gallery.rs. See docs/dev/adding-a-feature.md.
import { ComboBox } from "std-widgets.slint";
import { Btn, Card, Muted, Icon, IconBtn } from "../widgets.slint";
import { Theme } from "../theme.slint";

export struct GalleryTile {
    index: int,
    thumb: image,
    has-thumb: bool,
    name: string,
    size-text: string,
    // Video length, empty for photos.
    duration: string,
    selected: bool,
    video: bool,
    mime: string,
    // When it was taken, in local time. Empty when the phone did not say.
    date-text: string,
}

// State and callbacks shared with src/features/gallery.rs.
export global GalleryFeature {
    // The paired device the view is open for (Device ID, hex).
    in-out property <string> peer-id;
    in property <[GalleryTile]> items;
    in property <bool> loading;
    in property <bool> more;
    // Empty, or `permission`, `denied`, `declined`, `timeout`, `failed`, ...
    in property <string> error;
    in property <int> selected;
    // Items just sent to the download list.
    in property <int> queued;
    // The item shown large, or -1 for the grid.
    in-out property <int> detail: -1;
    // Which pictures: 0 all, 1 photos, 2 videos.
    in-out property <int> kind: 0;
    // "All albums", then one entry per album. `album-index` is the chosen one.
    in property <[string]> album-names: ["All albums"];
    in-out property <int> album-index: 0;
    // The sharper picture of the item shown large: which item, its state
    // (0 loading, 1 ready, 2 failed), and the picture.
    in property <int> preview-index: -1;
    in property <int> preview-state: 0;
    in property <image> preview;
    // True while the page is scrolled near its end. main.slint sets it.
    in-out property <bool> near-end;
    callback reload();
    callback load-more();
    callback toggle(int);
    callback select-all(bool);
    callback download();
    callback download-one(int);
    callback open-folder();
    callback set-kind(int);
    callback pick-album(int);
    callback want-preview(int);
}

// One square picture in the grid. A tap opens it; the round mark selects it.
component Tile inherits Rectangle {
    in property <GalleryTile> t;
    in property <length> side;
    width: side;
    height: side;
    border-radius: 8px;
    clip: true;
    background: Theme.surface-2;
    accessible-role: button;
    accessible-label: t.name;

    if t.has-thumb: Image {
        source: t.thumb;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }
    if !t.has-thumb: Icon {
        source: @image-url("../icons/image.svg");
        tint: Theme.muted;
        width: 28px;
        height: 28px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    // A hover or selection tint over the picture.
    Rectangle {
        background: t.selected ? Theme.accent.with-alpha(0.28) : open.has-hover ? #00000030 : transparent;
        border-width: t.selected ? 3px : 0px;
        border-color: Theme.accent;
        border-radius: 8px;
    }
    open := TouchArea {
        mouse-cursor: pointer;
        clicked => { GalleryFeature.detail = t.index; }
    }
    if t.duration != "": Rectangle {
        x: parent.width - self.width - 6px;
        y: parent.height - self.height - 6px;
        width: dur.preferred-width + 12px;
        height: 20px;
        border-radius: 10px;
        background: #000000b0;
        dur := Text {
            text: t.duration;
            color: white;
            font-size: 11px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    if t.video && t.duration == "": Icon {
        source: @image-url("../icons/play.svg");
        tint: white;
        x: parent.width - self.width - 6px;
        y: parent.height - self.height - 6px;
        width: 20px;
        height: 20px;
    }
    // The selection mark: shown on hover, or while anything is selected.
    Rectangle {
        x: 6px;
        y: 6px;
        width: 24px;
        height: 24px;
        border-radius: 12px;
        opacity: (open.has-hover || mark.has-hover || t.selected || GalleryFeature.selected > 0) ? 1 : 0;
        background: t.selected ? Theme.accent : #00000070;
        border-width: 2px;
        border-color: t.selected ? Theme.accent : white;
        accessible-role: checkbox;
        accessible-label: @tr("Select");
        accessible-checked: t.selected;
        if t.selected: Icon {
            source: @image-url("../icons/check.svg");
            tint: Theme.on-accent;
            width: 14px;
            height: 14px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        mark := TouchArea {
            mouse-cursor: pointer;
            clicked => { GalleryFeature.toggle(t.index); }
        }
    }
}

// One of the "All / Photos / Videos" choices.
component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> on;
    callback clicked();
    height: 30px;
    width: label.preferred-width + 28px;
    border-radius: 15px;
    background: on ? Theme.accent : ta.has-hover ? Theme.surface-2 : transparent;
    border-width: 1px;
    border-color: on ? Theme.accent : Theme.border;
    accessible-role: button;
    accessible-label: root.text;
    label := Text {
        text: root.text;
        color: on ? Theme.on-accent : Theme.text;
        font-size: Theme.font-body;
        font-weight: 600;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A round arrow over the big picture.
component Arrow inherits Rectangle {
    in property <bool> flip;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: ta.has-hover ? #000000c0 : #00000080;
    Icon {
        source: @image-url("../icons/back.svg");
        tint: white;
        transform-rotation: root.flip ? 180deg : 0deg;
        width: 20px;
        height: 20px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component InfoRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 12px;
    Text { text: root.label; color: Theme.muted; font-size: Theme.font-body; width: 72px; }
    Text { text: root.value; color: Theme.text; font-size: Theme.font-body; horizontal-stretch: 1; wrap: word-wrap; }
}

// One picture, large, with its details.
component Detail inherits VerticalLayout {
    in property <GalleryTile> t;
    // The sharper picture is for this item and has arrived.
    property <bool> sharp: GalleryFeature.preview-index == GalleryFeature.detail && GalleryFeature.preview-state == 1;
    property <bool> waiting: GalleryFeature.preview-index != GalleryFeature.detail || GalleryFeature.preview-state == 0;
    spacing: 12px;

    // Left and right arrows and Esc move around and close.
    FocusScope {
        height: 0px;
        init => { self.focus(); }
        key-pressed(e) => {
            if e.text == Key.LeftArrow {
                if GalleryFeature.detail > 0 { GalleryFeature.detail -= 1; }
                return accept;
            }
            if e.text == Key.RightArrow {
                if GalleryFeature.detail < GalleryFeature.items.length - 1 { GalleryFeature.detail += 1; }
                return accept;
            }
            if e.text == Key.Escape {
                GalleryFeature.detail = -1;
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        spacing: 10px;
        IconBtn {
            icon: @image-url("../icons/back.svg");
            label: @tr("Back to all");
            clicked => { GalleryFeature.detail = -1; }
        }
        Text {
            text: t.name;
            font-size: Theme.font-title;
            font-weight: 700;
            color: Theme.text;
            overflow: elide;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Muted {
            text: @tr("{} of {}", GalleryFeature.detail + 1, GalleryFeature.items.length);
            vertical-alignment: center;
        }
    }

    Rectangle {
        height: 440px;
        border-radius: 12px;
        clip: true;
        background: Theme.dark ? #0a120a : #e9e4d8;
        if t.has-thumb || root.sharp: Image {
            source: root.sharp ? GalleryFeature.preview : t.thumb;
            width: parent.width;
            height: parent.height;
            image-fit: contain;
        }
        if !t.has-thumb && !root.sharp: Icon {
            source: @image-url("../icons/image.svg");
            tint: Theme.muted;
            width: 48px;
            height: 48px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
        if t.video: Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 28px;
            background: #000000a0;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            Icon {
                source: @image-url("../icons/play.svg");
                tint: white;
                width: 28px;
                height: 28px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
        }
        if GalleryFeature.detail > 0: Arrow {
            x: 12px;
            y: (parent.height - self.height) / 2;
            clicked => { GalleryFeature.detail -= 1; }
        }
        if GalleryFeature.detail < GalleryFeature.items.length - 1: Arrow {
            flip: true;
            x: parent.width - self.width - 12px;
            y: (parent.height - self.height) / 2;
            clicked => { GalleryFeature.detail += 1; }
        }
    }

    Card {
        VerticalLayout {
            padding: 14px;
            spacing: 8px;
            InfoRow { label: @tr("Type"); value: (t.video ? @tr("Video") : @tr("Photo")) + (t.mime != "" ? " · " + t.mime : ""); }
            InfoRow { label: @tr("Size"); value: t.size-text; }
            if t.date-text != "": InfoRow { label: @tr("Taken"); value: t.date-text; }
            if t.duration != "": InfoRow { label: @tr("Length"); value: t.duration; }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Btn {
            text: @tr("Download");
            kind: 0;
            has-icon: false;
            clicked => { GalleryFeature.download-one(t.index); }
        }
        Btn {
            text: t.selected ? @tr("Unselect") : @tr("Select");
            kind: 1;
            clicked => { GalleryFeature.toggle(t.index); }
        }
    }
    if GalleryFeature.queued > 0: Muted {
        text: @tr("Downloading to your download folder.");
        color: Theme.allow-fg;
    }
    if root.waiting: Muted { text: @tr("Loading a sharper picture…"); }
    if !root.waiting && !root.sharp: Muted { text: @tr("Could not load a sharper picture. Download the file to see it in full."); wrap: word-wrap; }
}

export component GalleryView inherits VerticalLayout {
    // The tile that opened the view, for features with more than one tile.
    in property <string> tile;
    in property <string> peer-name;
    spacing: 12px;

    // Load the next page by itself: near the end of the grid, or three pictures from the end of
    // the big view. It does not retry after an error.
    property <bool> want-more: (GalleryFeature.detail >= 0 ? GalleryFeature.detail >= GalleryFeature.items.length - 3 : GalleryFeature.near-end)
        && GalleryFeature.more && !GalleryFeature.loading && GalleryFeature.error == "";
    changed want-more => { if root.want-more { GalleryFeature.load-more(); } }
    // Ask for the sharper picture whenever another item is shown large.
    property <int> shown: GalleryFeature.detail;
    changed shown => { if root.shown >= 0 { GalleryFeature.want-preview(root.shown); } }

    if GalleryFeature.detail >= 0 && GalleryFeature.detail < GalleryFeature.items.length: Detail {
        t: GalleryFeature.items[GalleryFeature.detail];
    }

    if GalleryFeature.detail < 0 || GalleryFeature.detail >= GalleryFeature.items.length: VerticalLayout {
        spacing: 12px;

        // Which pictures: all, photos or videos, and an album.
        HorizontalLayout {
            spacing: 6px;
            FilterChip { text: @tr("All"); on: GalleryFeature.kind == 0; clicked => { GalleryFeature.set-kind(0); } }
            FilterChip { text: @tr("Photos"); on: GalleryFeature.kind == 1; clicked => { GalleryFeature.set-kind(1); } }
            FilterChip { text: @tr("Videos"); on: GalleryFeature.kind == 2; clicked => { GalleryFeature.set-kind(2); } }
            Rectangle { horizontal-stretch: 1; }
            if GalleryFeature.album-names.length > 1: ComboBox {
                width: 220px;
                model: GalleryFeature.album-names;
                current-index <=> GalleryFeature.album-index;
                selected(v) => { GalleryFeature.pick-album(self.current-index); }
            }
        }

        // Nothing selected: a count and two small actions. Something selected: the selection bar.
        if GalleryFeature.selected == 0: HorizontalLayout {
            spacing: 8px;
            Text {
                text: @tr("{} photos and videos", "\{GalleryFeature.items.length}\{GalleryFeature.more ? "+" : ""}");
                font-size: Theme.font-body;
                font-weight: 600;
                color: Theme.text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Btn { text: @tr("Select all"); kind: 3; enabled: GalleryFeature.items.length > 0; clicked => { GalleryFeature.select-all(true); } }
            Btn { text: @tr("Reload"); kind: 3; clicked => { GalleryFeature.reload(); } }
            IconBtn { icon: @image-url("../icons/folder.svg"); label: @tr("Open download folder"); clicked => { GalleryFeature.open-folder(); } }
        }
        if GalleryFeature.selected > 0: Rectangle {
            height: 48px;
            border-radius: 24px;
            background: Theme.icon-bg;
            HorizontalLayout {
                padding-left: 18px;
                padding-right: 8px;
                spacing: 8px;
                Text {
                    text: @tr("{} selected", GalleryFeature.selected);
                    font-size: Theme.font-body;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Btn { text: @tr("Select all"); kind: 3; y: (parent.height - self.height) / 2; clicked => { GalleryFeature.select-all(true); } }
                Btn { text: @tr("Clear"); kind: 3; y: (parent.height - self.height) / 2; clicked => { GalleryFeature.select-all(false); } }
                Btn { text: @tr("Download"); kind: 0; y: (parent.height - self.height) / 2; clicked => { GalleryFeature.download(); } }
            }
        }
        if GalleryFeature.queued > 0: Muted {
            text: @tr("Downloading {} to your download folder.", GalleryFeature.queued);
            color: Theme.allow-fg;
        }
        if GalleryFeature.error != "": Card {
            VerticalLayout {
                padding: 14px;
                Text {
                    wrap: word-wrap;
                    color: Theme.deny-fg;
                    text: GalleryFeature.error == "permission" ? @tr("Allow UrDevice to read photos and videos on {}, then reload.", root.peer-name)
                        : GalleryFeature.error == "denied" ? @tr("{} has Gallery turned off.", root.peer-name)
                        : GalleryFeature.error == "declined" ? @tr("{} declined the request.", root.peer-name)
                        : GalleryFeature.error == "timeout" ? @tr("{} did not answer in time.", root.peer-name)
                        : GalleryFeature.error == "offline" ? @tr("{} is not connected.", root.peer-name)
                        : GalleryFeature.error == "unsupported" ? @tr("{} has no gallery.", root.peer-name)
                        : @tr("Could not load the gallery.");
                }
            }
        }
        if GalleryFeature.loading && GalleryFeature.items.length == 0: Muted { text: @tr("Waiting for {}…", root.peer-name); }
        if !GalleryFeature.loading && GalleryFeature.error == "" && GalleryFeature.items.length == 0: Muted { text: @tr("No photos or videos."); }

        // A wrapping grid of square pictures that share the width.
        grid := Rectangle {
            property <length> gap: 8px;
            property <int> cols: max(2, floor((self.width + gap) / (160px + gap)));
            property <length> side: (self.width - (cols - 1) * gap) / cols;
            property <int> rows: ceil(GalleryFeature.items.length / cols);
            height: rows > 0 ? rows * (side + gap) - gap : 0px;
            for t[i] in GalleryFeature.items: Tile {
                t: t;
                side: grid.side;
                x: mod(i, grid.cols) * (grid.side + grid.gap);
                y: floor(i / grid.cols) * (grid.side + grid.gap);
            }
        }
        if GalleryFeature.more && GalleryFeature.loading && GalleryFeature.items.length > 0: Muted { text: @tr("Loading…"); horizontal-alignment: center; }
        // Only after an error: the next page is otherwise loaded by itself.
        if GalleryFeature.more && GalleryFeature.error != "" && GalleryFeature.items.length > 0: HorizontalLayout {
            alignment: center;
            Btn { text: @tr("Try again"); clicked => { GalleryFeature.load-more(); } }
        }
    }
}
