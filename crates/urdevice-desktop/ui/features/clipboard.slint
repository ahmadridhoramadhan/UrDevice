// Clipboard sharing (#16). The per-device switch is a tile on the paired-device
// page (see main.slint); this view only reports the global pause.
// Rust side: src/features/clipboard.rs. See docs/dev/adding-a-feature.md.
import { Muted } from "../widgets.slint";

// State and callbacks shared with src/features/clipboard.rs.
export global ClipboardFeature {
    // "Pause clipboard on all devices" is on (R7.6, Settings).
    in-out property <bool> paused;
    // The last thing that happened, without any content.
    in-out property <string> status;
    callback set-paused(bool);
}

export component ClipboardView inherits VerticalLayout {
    // The tile that opened the view, for features with more than one tile.
    in property <string> tile;
    in property <string> peer-name;
    spacing: 10px;
    if ClipboardFeature.paused: Muted {
        text: @tr("Clipboard sharing is paused for all devices. Turn it back on in Settings.");
    }
    if ClipboardFeature.status != "": Muted { text: ClipboardFeature.status; }
}
