// Media control (#20, design §9.4): the desktop feature view.
// Rust side: src/features/media.rs. See docs/dev/adding-a-feature.md.
import { Icon, Card, Toggle, Muted, SectionTitle } from "../widgets.slint";
import { Theme } from "../theme.slint";

// State and callbacks shared with src/features/media.rs.
export global MediaFeature {
    // The paired device the view is open for (Device ID, hex).
    in-out property <string> peer-id;
    // The device page shows the player: the device is connected and lists media.
    in property <bool> available;
    // The media player for this host is on (R11.6).
    in-out property <bool> on: true;
    // Why there is nothing to show (0 none, 1 offline, 2 turned off by the
    // host, 3 player off, 4 waiting, 5 Android notification access off,
    // 6 host cannot read sessions, 7 nothing playing, 8 request refused).
    in property <int> message-kind;
    // One tab per media app on the host, and the one selected.
    in property <[string]> tabs;
    in-out property <int> selected: 0;
    // The selected session.
    in property <string> app-name;
    in property <string> title;
    in property <string> artist;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <bool> playing;
    // Position as a fraction of the track (0..1), and as text.
    in property <float> progress;
    in property <string> position-text;
    in property <string> duration-text;
    // Only the controls the session supports are shown (R11.5).
    in property <bool> can-seek;
    in property <bool> can-prev;
    in property <bool> can-next;
    in property <bool> can-play-pause;
    // The host's system volume.
    in property <float> volume;
    in property <bool> muted;
    in property <bool> can-volume;

    callback set-on(bool);
    callback pick(int);
    callback play-pause();
    callback prev();
    callback next();
    // Jump to a fraction of the track.
    callback seek(float);
    // Set the volume to a fraction, while dragging (throttled in Rust) and on release.
    callback set-volume(float, bool);
    callback set-muted(bool);
}

// A horizontal slider: `value` is 0..1. `moved` fires while dragging and
// `released` when the pointer is let go.
component MediaSlider inherits Rectangle {
    in property <float> value;
    in property <bool> enabled: true;
    out property <bool> dragging: ta.pressed;
    callback moved(float);
    callback released(float);
    property <float> shown: ta.pressed ? max(0, min(1, ta.mouse-x / root.width)) : max(0, min(1, root.value));
    height: 22px;
    opacity: root.enabled ? 1 : 0.5;
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: parent.width;
        height: 4px;
        border-radius: 2px;
        background: Theme.border;
    }
    Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        height: 4px;
        width: parent.width * root.shown;
        border-radius: 2px;
        background: Theme.accent;
    }
    Rectangle {
        x: max(0px, min(parent.width - self.width, parent.width * root.shown - self.width / 2));
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 7px;
        background: Theme.accent;
        visible: root.enabled;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        moved => { root.moved(max(0, min(1, self.mouse-x / root.width))); }
        changed pressed => {
            if (!self.pressed) {
                root.released(max(0, min(1, self.mouse-x / root.width)));
            }
        }
    }
}

component RoundButton inherits Rectangle {
    in property <image> icon;
    in property <length> size: 40px;
    in property <bool> primary: false;
    in property <string> label;
    callback clicked();
    width: size;
    height: size;
    border-radius: size / 2;
    background: primary ? (ta.has-hover ? Theme.accent.darker(0.15) : Theme.accent) : (ta.has-hover ? Theme.surface-2 : transparent);
    border-width: primary ? 0 : 1px;
    border-color: Theme.border;
    accessible-role: button;
    accessible-label: root.label;
    Icon {
        source: root.icon;
        tint: root.primary ? Theme.on-accent : Theme.text;
        width: root.size * 0.45;
        height: root.size * 0.45;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// One tab per media app, shown when the host has more than one.
component MediaTab inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 34px;
    border-radius: 17px;
    background: root.active ? Theme.accent : ta.has-hover ? Theme.surface-2 : transparent;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.active;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.active ? Theme.on-accent : Theme.muted;
            }
        }
        Text {
            text: root.text;
            color: root.active ? Theme.on-accent : Theme.muted;
            font-size: Theme.font-body;
            font-weight: root.active ? 700 : 500;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The media player on the device page (R11): a title with the Active switch, and a card with
// tabs (only when there is more than one media app), the track, the seek bar, the controls,
// and the volume. No shuffle or repeat (R11). The page shows it only while `MediaFeature.available`.
export component MediaPanel inherits VerticalLayout {
    in property <string> peer-name;
    spacing: 10px;

    HorizontalLayout {
        spacing: 10px;
        SectionTitle {
            text: @tr("Media player");
            vertical-alignment: center;
        }
        Rectangle { }
        Text {
            text: @tr("Active");
            color: Theme.muted;
            font-size: Theme.font-body;
            font-weight: 600;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Toggle {
                checked: MediaFeature.on;
                enabled: MediaFeature.message-kind != 2;
                toggled(on) => { MediaFeature.set-on(on); }
            }
        }
    }

    // Why there is nothing to show. "Player off" needs no line: the switch says it.
    if MediaFeature.message-kind != 0 && MediaFeature.message-kind != 3: Muted {
        text: [
            "",
            @tr("{} is offline.", root.peer-name),
            @tr("Media control is turned off by {}.", root.peer-name),
            "",
            @tr("Waiting for {}…", root.peer-name),
            @tr("Notification access is off on {}. Turn it on in the Android settings so other devices can see and control media.", root.peer-name),
            @tr("{} cannot read its media apps.", root.peer-name),
            @tr("Nothing is playing on {}.", root.peer-name),
            @tr("{} did not allow that.", root.peer-name),
        ][MediaFeature.message-kind];
    }

    if MediaFeature.on && MediaFeature.tabs.length > 0: Card {
        VerticalLayout {
            if MediaFeature.tabs.length > 1: VerticalLayout {
                HorizontalLayout {
                    padding: 10px;
                    spacing: 6px;
                    alignment: start;
                    for name[i] in MediaFeature.tabs: MediaTab {
                        text: name;
                        active: MediaFeature.selected == i;
                        clicked => { MediaFeature.pick(i); }
                    }
                }
                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }
            }
            HorizontalLayout {
                padding: 16px;
                spacing: 18px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 96px;
                        height: 96px;
                        border-radius: 14px;
                        background: Theme.accent;
                        clip: true;
                        if MediaFeature.has-artwork: Image {
                            source: MediaFeature.artwork;
                            image-fit: cover;
                            width: parent.width;
                            height: parent.height;
                        }
                        if !MediaFeature.has-artwork: Icon {
                            source: @image-url("../icons/music.svg");
                            tint: Theme.on-accent;
                            width: 40px;
                            height: 40px;
                        }
                    }
                }
                VerticalLayout {
                    spacing: 6px;
                    alignment: center;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: MediaFeature.app-name;
                            font-size: Theme.font-small;
                            font-weight: 700;
                            color: Theme.accent;
                            overflow: elide;
                        }
                        Text {
                            text: MediaFeature.title != "" ? MediaFeature.title : @tr("Unknown title");
                            font-size: Theme.font-title;
                            font-weight: 700;
                            color: Theme.text;
                            overflow: elide;
                        }
                        if MediaFeature.artist != "": Text {
                            text: MediaFeature.artist;
                            font-size: Theme.font-body;
                            color: Theme.muted;
                            overflow: elide;
                        }
                    }
                    if MediaFeature.can-seek: VerticalLayout {
                        spacing: 2px;
                        MediaSlider {
                            value: MediaFeature.progress;
                            released(v) => { MediaFeature.seek(v); }
                        }
                        HorizontalLayout {
                            Text { text: MediaFeature.position-text; font-size: Theme.font-small; color: Theme.muted; }
                            Rectangle { }
                            Text { text: MediaFeature.duration-text; font-size: Theme.font-small; color: Theme.muted; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        if MediaFeature.can-prev: VerticalLayout {
                            alignment: center;
                            RoundButton {
                                icon: @image-url("../icons/media-prev.svg");
                                label: @tr("Previous");
                                size: 38px;
                                clicked => { MediaFeature.prev(); }
                            }
                        }
                        if MediaFeature.can-play-pause: VerticalLayout {
                            alignment: center;
                            RoundButton {
                                icon: MediaFeature.playing ? @image-url("../icons/media-pause.svg") : @image-url("../icons/media-play.svg");
                                label: MediaFeature.playing ? @tr("Pause") : @tr("Play");
                                primary: true;
                                size: 52px;
                                clicked => { MediaFeature.play-pause(); }
                            }
                        }
                        if MediaFeature.can-next: VerticalLayout {
                            alignment: center;
                            RoundButton {
                                icon: @image-url("../icons/media-next.svg");
                                label: @tr("Next");
                                size: 38px;
                                clicked => { MediaFeature.next(); }
                            }
                        }
                        Rectangle { }
                        if MediaFeature.can-volume: HorizontalLayout {
                            spacing: 10px;
                            VerticalLayout {
                                alignment: center;
                                RoundButton {
                                    size: 32px;
                                    icon: MediaFeature.muted ? @image-url("../icons/media-mute.svg") : @image-url("../icons/media-volume.svg");
                                    label: MediaFeature.muted ? @tr("Unmute") : @tr("Mute");
                                    clicked => { MediaFeature.set-muted(!MediaFeature.muted); }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                MediaSlider {
                                    width: 120px;
                                    value: MediaFeature.muted ? 0 : MediaFeature.volume;
                                    moved(v) => { MediaFeature.set-volume(v, false); }
                                    released(v) => { MediaFeature.set-volume(v, true); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Kept so `features.slint` lists every feature. The player has no page of its own now: it is the
// `MediaPanel` on the device page.
export component MediaView inherits VerticalLayout {
    in property <string> tile;
    in property <string> peer-name;
    MediaPanel { peer-name: root.peer-name; }
}
