// UrDevice desktop UI (design §12). Layout follows docs/mockup/urdevice-layout.html
// and docs/mockup/onboarding.html. All text goes through @tr (R16.4).
import { LineEdit, ScrollView, AboutSlint } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Icon, IconBox, Btn, Card, Chip, Dot, ModeSwitch, Toggle, SectionTitle, Muted } from "widgets.slint";
import { Labels } from "labels.slint";
import { FeatureView } from "features/features.slint";
import { ClipboardFeature } from "features/clipboard.slint";
import { FilesSettings } from "features/files.slint";
// Localhost sharing (#22): this device's shared ports and the LAN indicator.
import { TunnelHostSection, TunnelLanBanner } from "features/tunnel.slint";

export { Labels } from "labels.slint";
// The feature globals, for src/features/*.rs.
export * from "features/globals.slint";

export struct PermItem {
    cap: string,
    label: string,
    desc: string,
    icon: image,
    mode: int,
    local-only: bool,
}

export struct PeerItem {
    id: string,
    name: string,
    platform: string,
    // "connected", "offline", or "disconnected"
    status: string,
    status-text: string,
    address: string,
    path: string,
    rtt: string,
    battery: string,
    fingerprint: string,
}

export struct TileItem {
    cap: string,
    // Label and icon key, for example "keyboard" for the second input tile.
    key: string,
    // The feature id (src/features/<feature>.rs).
    feature: string,
    // True when the tile opens the feature's view instead of only asking.
    view: bool,
    label: string,
    icon: image,
    // 0 allow, 1 ask, 2 deny
    mode: int,
}

export struct NearbyItem {
    key: string,
    name: string,
    platform: string,
    address: string,
}

export struct CodeItem {
    key: string,
    name: string,
    code: string,
    confirmed: bool,
    incoming: bool,
}

export struct ActivityItem {
    id: string,
    device: string,
    label: string,
    incoming: bool,
}

export struct LogItem {
    device: string,
    label: string,
    decision: string,
    decision-label: string,
    time: string,
}

export enum Page { this-device, peer, pair, settings, log, feature }

component PermRow inherits Card {
    in property <PermItem> item;
    callback picked(int);
    height: 60px;
    HorizontalLayout {
        padding: 12px;
        spacing: 12px;
        IconBox { icon: item.icon; size: 34px; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center;
            Text { text: item.label; font-size: Theme.font-body; font-weight: 600; color: Theme.text; }
            Text { text: item.desc; font-size: Theme.font-small; color: Theme.muted; overflow: elide; }
        }
        ModeSwitch {
            y: (parent.height - self.height) / 2;
            mode: item.mode;
            picked(m) => { root.picked(m); }
        }
    }
}

component SideItem inherits Rectangle {
    in property <string> title;
    in property <string> line1;
    in property <string> line2;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> online;
    in property <bool> show-dot: true;
    callback clicked();
    height: 64px;
    border-radius: Theme.radius;
    background: selected ? Theme.surface : ta.has-hover ? Theme.surface-2 : transparent;
    border-width: selected ? 2px : 0;
    border-color: Theme.accent.with-alpha(0.5);
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        IconBox { icon: root.icon; size: 34px; y: (parent.height - self.height) / 2; }
        VerticalLayout {
            alignment: center;
            Text { text: root.title; font-weight: 600; font-size: Theme.font-body; color: Theme.text; overflow: elide; }
            Text { text: root.line1; font-size: Theme.font-small; color: Theme.muted; overflow: elide; }
            if root.line2 != "": Text { text: root.line2; font-size: Theme.font-small; color: Theme.muted; overflow: elide; }
        }
        if root.show-dot: Dot { on: root.online; y: (parent.height - self.height) / 2; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component QrBox inherits Rectangle {
    in property <image> qr;
    in property <string> countdown;
    in property <string> locked;
    width: 220px;
    height: 250px;
    VerticalLayout {
        spacing: 8px;
        alignment: start;
        Rectangle {
            width: 200px;
            height: 200px;
            x: 10px;
            border-radius: 12px;
            background: #ffffff;
            if root.locked == "": Image {
                source: root.qr;
                width: 184px;
                height: 184px;
                image-rendering: pixelated;
            }
            if root.locked != "": Text {
                text: root.locked;
                color: #8a2c2c;
                wrap: word-wrap;
                width: 170px;
                horizontal-alignment: center;
            }
        }
        Text {
            text: root.countdown;
            wrap: word-wrap;
            horizontal-alignment: center;
            font-size: Theme.font-small;
            color: Theme.muted;
        }
    }
}

component CodeConfirm inherits Rectangle {
    in property <CodeItem> item;
    callback answer(bool);
    height: 66px;
    border-radius: 8px;
    background: Theme.surface-2;
    HorizontalLayout {
        padding: 10px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Text { text: item.incoming ? @tr("{} wants to pair. Check the code on both screens.", item.name) : @tr("Check that {} shows this code.", item.name); font-size: Theme.font-small; color: Theme.muted; }
            Text { text: item.code; font-size: 22px; font-weight: 700; letter-spacing: 4px; color: Theme.text; font-family: "monospace"; }
        }
        if !item.confirmed: Btn { text: @tr("Codes match"); kind: 0; y: (parent.height - self.height) / 2; clicked => { root.answer(true); } }
        if item.confirmed: Text { text: @tr("Waiting for the other device…"); color: Theme.muted; vertical-alignment: center; font-size: Theme.font-small; }
        Btn { text: @tr("Cancel"); y: (parent.height - self.height) / 2; clicked => { root.answer(false); } }
    }
}

// The Pair screen body, shared by onboarding step 4/5 and "Add device".
component PairBody inherits VerticalLayout {
    in property <image> qr;
    in property <string> countdown;
    in property <string> locked;
    in property <bool> has-camera;
    in property <[NearbyItem]> nearby;
    in property <[CodeItem]> codes;
    callback scan();
    callback pair-nearby(string);
    callback confirm-code(string, bool);
    spacing: 16px;
    HorizontalLayout {
        spacing: 24px;
        alignment: start;
        QrBox { qr: root.qr; countdown: root.countdown; locked: root.locked; }
        VerticalLayout {
            spacing: 10px;
            alignment: start;
            SectionTitle { text: @tr("Scan this code with the other device"); }
            Muted { text: @tr("On the phone, open UrDevice, tap Add Device, and scan. The code works once and changes every 2 minutes."); }
            if root.has-camera: HorizontalLayout {
                alignment: start;
                Btn { text: @tr("Scan QR"); has-icon: true; icon: @image-url("icons/camera.svg"); clicked => { root.scan(); } }
            }
        }
    }
    SectionTitle { text: @tr("Devices on the network"); }
    Muted { text: @tr("Pick a device. Both screens then show the same 6-digit code."); }
    for c in root.codes: CodeConfirm {
        item: c;
        answer(ok) => { root.confirm-code(c.key, ok); }
    }
    if root.nearby.length == 0 && root.codes.length == 0: Muted { text: @tr("No devices found yet. Open UrDevice on the other device, on the same Wi-Fi."); }
    for n in root.nearby: Card {
        height: 54px;
        HorizontalLayout {
            padding: 10px;
            spacing: 10px;
            IconBox { icon: n.platform == "Android" ? @image-url("icons/phone.svg") : @image-url("icons/laptop.svg"); size: 32px; y: (parent.height - self.height) / 2; }
            VerticalLayout {
                alignment: center;
                Text { text: n.name; font-weight: 600; color: Theme.text; font-size: Theme.font-body; }
                Text { text: n.platform + " · " + n.address; color: Theme.muted; font-size: Theme.font-small; }
            }
            Btn { text: @tr("Pair"); y: (parent.height - self.height) / 2; clicked => { root.pair-nearby(n.key); } }
        }
    }
}

component Onboarding inherits Rectangle {
    in-out property <int> step: 1;
    in-out property <string> name;
    in property <string> fingerprint;
    in property <[PermItem]> perms;
    in property <image> qr;
    in property <string> countdown;
    in property <string> locked;
    in property <bool> has-camera;
    in property <[NearbyItem]> nearby;
    in property <[CodeItem]> codes;
    in property <string> paired-name;
    callback set-mode(int, int);
    callback save(string);
    callback open-pair();
    callback close-pair();
    callback scan();
    callback pair-nearby(string);
    callback confirm-code(string, bool);
    callback finish();
    background: Theme.forest;

    Rectangle {
        width: min(parent.width - 48px, 860px);
        height: min(parent.height - 48px, 620px);
        border-radius: 14px;
        background: #132214;
        border-width: 1px;
        border-color: #2a3d2c;
        HorizontalLayout {
            Rectangle {
                width: 200px;
                border-width: 0;
                Rectangle {
                    width: 84px;
                    height: 84px;
                    border-radius: 20px;
                    background: Theme.lime;
                    Icon {
                        width: 40px;
                        height: 40px;
                        tint: Theme.forest;
                        source: root.step == 1 ? @image-url("icons/hand.svg")
                            : root.step == 2 ? @image-url("icons/shield.svg")
                            : root.step == 3 ? @image-url("icons/list.svg")
                            : root.step <= 5 ? @image-url("icons/qr.svg")
                            : @image-url("icons/check.svg");
                    }
                }
            }
            Rectangle { width: 1px; background: #2a3d2c; }
            VerticalLayout {
                padding: 24px;
                spacing: 14px;
                HorizontalLayout {
                    spacing: 6px;
                    for i in 6: Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: i < root.step ? Theme.lime : #2a3d2c;
                    }
                }
                if root.step == 1: VerticalLayout {
                    spacing: 10px;
                    Text { text: @tr("Welcome to UrDevice"); font-size: 22px; font-weight: 700; color: #e8f5dc; }
                    Text { text: @tr("Connect your own devices on one local network. No account and no cloud server."); color: #b9cdb4; wrap: word-wrap; }
                    Text { text: @tr("Name this device"); color: #e8f5dc; font-weight: 600; }
                    name-edit := LineEdit {
                        text <=> root.name;
                        placeholder-text: @tr("Device name");
                    }
                    Text { text: @tr("Other devices see this name. You can change it later in Settings."); color: #9fb59a; font-size: Theme.font-small; }
                }
                if root.step == 2: VerticalLayout {
                    spacing: 10px;
                    Text { text: @tr("Safe and local"); font-size: 22px; font-weight: 700; color: #e8f5dc; }
                    Text { text: @tr("Your devices talk directly on the same network. There is no server, and every connection is encrypted with this device's own key."); color: #b9cdb4; wrap: word-wrap; }
                    Text { text: @tr("The key for this device is ready and kept in the system keychain. Its Device ID:"); color: #b9cdb4; wrap: word-wrap; }
                    Rectangle {
                        height: 44px;
                        border-radius: 8px;
                        background: #0c180d;
                        Text { text: root.fingerprint; font-family: "monospace"; color: Theme.lime; font-size: 14px; }
                    }
                    Text { text: @tr("Check this ID on the other device when you pair."); color: #9fb59a; font-size: Theme.font-small; }
                }
                if root.step == 3: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 8px;
                    Text { text: @tr("Permissions for other devices"); font-size: 22px; font-weight: 700; color: #e8f5dc; }
                    Text { text: @tr("Choose what your other devices may do here. This applies to every paired device. You can change it later on This device."); color: #b9cdb4; wrap: word-wrap; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 6px;
                            alignment: start;
                            for p[i] in root.perms: PermRow {
                                item: p;
                                picked(m) => { root.set-mode(i, m); }
                            }
                        }
                    }
                }
                if root.step == 4 || root.step == 5: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 8px;
                        Text { text: @tr("Pair your first device"); font-size: 22px; font-weight: 700; color: #e8f5dc; }
                        Rectangle {
                            border-radius: 10px;
                            background: Theme.surface;
                            VerticalLayout {
                                padding: 14px;
                                PairBody {
                                    qr: root.qr;
                                    countdown: root.countdown;
                                    locked: root.locked;
                                    has-camera: root.has-camera;
                                    nearby: root.nearby;
                                    codes: root.codes;
                                    scan => { root.scan(); }
                                    pair-nearby(k) => { root.pair-nearby(k); }
                                    confirm-code(k, ok) => { root.confirm-code(k, ok); }
                                }
                            }
                        }
                    }
                }
                if root.step == 6: VerticalLayout {
                    spacing: 10px;
                    Text { text: root.paired-name != "" ? @tr("Paired with {}", root.paired-name) : @tr("Ready"); font-size: 22px; font-weight: 700; color: #e8f5dc; }
                    Text { text: root.paired-name != "" ? @tr("Both devices are connected. They reconnect on their own when they are on the same network.") : @tr("You can pair a device any time with Add Device."); color: #b9cdb4; wrap: word-wrap; }
                }
                if root.step <= 2 || root.step == 6: Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    if root.step > 1 && root.step < 4: Btn {
                        text: @tr("Back");
                        clicked => { root.step -= 1; }
                    }
                    if root.step == 4 || root.step == 5: Btn {
                        text: @tr("Skip for now");
                        clicked => { root.close-pair(); root.step = 6; }
                    }
                    if root.step < 3: Btn {
                        text: @tr("Continue");
                        kind: 0;
                        enabled: root.name != "";
                        clicked => { root.step += 1; }
                    }
                    if root.step == 3: Btn {
                        text: @tr("Save and continue");
                        kind: 0;
                        clicked => { root.save(root.name); root.open-pair(); root.step = 4; }
                    }
                    if root.step == 6: Btn {
                        text: @tr("Open UrDevice");
                        kind: 0;
                        clicked => { root.finish(); }
                    }
                }
            }
        }
    }
}

export component PromptWindow inherits Window {
    in property <string> device;
    in property <string> feature;
    in property <int> seconds-left: 30;
    callback answer(bool);
    title: @tr("UrDevice: permission request");
    icon: @image-url("../../../assets/urdevice-icon-512.png");
    always-on-top: true;
    width: 400px;
    height: 200px;
    background: Theme.surface;
    VerticalLayout {
        padding: 20px;
        spacing: 12px;
        Text { text: @tr("{} wants to use {} on this device.", root.device, root.feature); font-size: Theme.font-title; font-weight: 600; color: Theme.text; wrap: word-wrap; }
        Muted { text: @tr("This setting is Always Ask. If you don't answer, the request is denied in {} s.", root.seconds-left); }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            alignment: end;
            spacing: 10px;
            Btn { text: @tr("Deny"); kind: 2; clicked => { root.answer(false); } }
            Btn { text: @tr("Allow"); kind: 0; clicked => { root.answer(true); } }
        }
    }
}

export component ScanWindow inherits Window {
    in property <image> frame;
    in property <string> status;
    callback cancel();
    title: @tr("Scan QR");
    icon: @image-url("../../../assets/urdevice-icon-512.png");
    width: 520px;
    height: 460px;
    background: Theme.surface;
    VerticalLayout {
        padding: 16px;
        spacing: 10px;
        Rectangle {
            background: #000000;
            border-radius: 10px;
            clip: true;
            Image { source: root.frame; width: parent.width; height: parent.height; image-fit: contain; }
        }
        Muted { text: root.status; }
        HorizontalLayout {
            alignment: end;
            Btn { text: @tr("Cancel"); clicked => { root.cancel(); } }
        }
    }
}

export component MainWindow inherits Window {
    // This device
    in property <string> me-name;
    in property <string> me-platform;
    in property <string> me-fingerprint;
    in property <string> me-address;
    in property <string> me-battery;
    in property <bool> me-hidden;
    in property <bool> autostart;
    in property <string> core-version;
    in property <[PermItem]> permissions;
    in property <[PermItem]> onboarding-perms;

    // Devices
    in property <[PeerItem]> peers;
    in property <PeerItem> peer;
    in property <[TileItem]> tiles;
    in property <[NearbyItem]> nearby;
    in property <[CodeItem]> codes;
    in property <[ActivityItem]> activities;
    in property <[LogItem]> log;

    // Pair screen
    in property <image> qr;
    in property <string> qr-countdown;
    in property <string> pair-locked;
    in property <bool> has-camera;

    in-out property <bool> onboarding: false;
    in-out property <int> onboarding-step: 1;
    in-out property <string> onboarding-name;
    in property <string> paired-name;
    in-out property <Page> page: Page.this-device;
    in-out property <string> selected-peer;
    // The open feature view: feature id and tile key.
    in-out property <string> feature;
    in-out property <string> feature-tile;
    in property <string> toast;
    in property <string> data-path;

    // Confirmations
    in-out property <string> confirm-cap;
    in-out property <string> confirm-forget;
    in-out property <bool> confirm-reset;
    in-out property <bool> confirm-delete;

    callback set-onboarding-mode(int, int);
    callback complete-onboarding(string);
    callback set-permission(string, int, bool);
    callback open-pair();
    callback close-pair();
    callback scan-qr();
    callback pair-nearby(string);
    callback confirm-code(string, bool);
    callback select-peer(string);
    callback disconnect(string);
    callback reconnect(string);
    callback forget(string);
    callback request(string, string);
    // A tile with a view opened it: peer id, feature id, tile key.
    callback open-feature(string, string, string);
    callback stop-activity(string);
    callback set-name(string);
    callback set-hidden(bool);
    callback set-autostart(bool);
    callback reset-identity();
    callback export-data();
    callback delete-all();
    callback show-log();

    title: "UrDevice";
    icon: @image-url("../../../assets/urdevice-icon-512.png");
    preferred-width: 1100px;
    preferred-height: 740px;
    min-width: 860px;
    min-height: 560px;
    background: Theme.bg;
    default-font-size: Theme.font-body;

    function go-pair() {
        root.page = Page.pair;
        root.open-pair();
    }

    function leave-pair() {
        if (root.page == Page.pair) {
            root.close-pair();
        }
    }

    if root.onboarding: Onboarding {
        step <=> root.onboarding-step;
        name <=> root.onboarding-name;
        fingerprint: root.me-fingerprint;
        perms: root.onboarding-perms;
        qr: root.qr;
        countdown: root.qr-countdown;
        locked: root.pair-locked;
        has-camera: root.has-camera;
        nearby: root.nearby;
        codes: root.codes;
        paired-name: root.paired-name;
        set-mode(i, m) => { root.set-onboarding-mode(i, m); }
        save(n) => { root.complete-onboarding(n); }
        open-pair => { root.open-pair(); }
        close-pair => { root.close-pair(); }
        scan => { root.scan-qr(); }
        pair-nearby(k) => { root.pair-nearby(k); }
        confirm-code(k, ok) => { root.confirm-code(k, ok); }
        finish => { root.close-pair(); root.onboarding = false; root.page = Page.this-device; }
    }

    if !root.onboarding: HorizontalLayout {
        // Sidebar
        Rectangle {
            width: 260px;
            background: Theme.sidebar;
            VerticalLayout {
                padding: 14px;
                spacing: 8px;
                HorizontalLayout {
                    spacing: 10px;
                    padding-bottom: 6px;
                    Image { source: @image-url("../../../assets/urdevice-icon-512.png"); width: 40px; height: 40px; }
                    Text { text: "UrDevice"; font-size: 22px; font-weight: 500; color: Theme.text; vertical-alignment: center; }
                }
                SideItem {
                    title: root.me-name;
                    line1: @tr("This device · {}", root.me-platform);
                    line2: root.me-address + (root.me-battery != "" ? " · " + @tr("Battery {}", root.me-battery) : "");
                    icon: @image-url("icons/laptop.svg");
                    selected: root.page == Page.this-device;
                    online: true;
                    clicked => { leave-pair(); root.page = Page.this-device; }
                }
                Rectangle { height: 1px; background: Theme.border; }
                Text { text: @tr("Devices"); font-size: Theme.font-small; font-weight: 700; color: Theme.muted; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 4px;
                        alignment: start;
                        for p in root.peers: SideItem {
                            title: p.name;
                            line1: p.status == "connected" ? p.platform + " · " + p.path + " · " + p.rtt : p.platform + " · " + p.status-text;
                            line2: p.status == "connected" && p.battery != "" ? @tr("Battery {}", p.battery) : "";
                            icon: p.platform == "Android" ? @image-url("icons/phone.svg") : @image-url("icons/laptop.svg");
                            selected: (root.page == Page.peer || root.page == Page.feature) && root.selected-peer == p.id;
                            online: p.status == "connected";
                            clicked => { leave-pair(); root.select-peer(p.id); root.page = Page.peer; }
                        }
                        Rectangle {
                            height: 40px;
                            border-radius: Theme.radius;
                            border-width: 1px;
                            border-color: Theme.border;
                            background: add-ta.has-hover ? Theme.surface-2 : transparent;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Icon { source: @image-url("icons/plus.svg"); tint: Theme.accent; width: 14px; height: 14px; y: (parent.height - self.height) / 2; }
                                Text { text: @tr("Add Device"); color: Theme.accent; font-weight: 700; vertical-alignment: center; }
                            }
                            add-ta := TouchArea { mouse-cursor: pointer; clicked => { go-pair(); } }
                        }
                    }
                }
                Rectangle {
                    height: 36px;
                    border-radius: 8px;
                    background: root.page == Page.settings || root.page == Page.log ? Theme.surface : set-ta.has-hover ? Theme.surface-2 : transparent;
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        Icon { source: @image-url("icons/gear.svg"); y: (parent.height - self.height) / 2; }
                        Text { text: @tr("Settings"); font-weight: 600; color: Theme.text; vertical-alignment: center; }
                    }
                    set-ta := TouchArea { mouse-cursor: pointer; clicked => { leave-pair(); root.page = Page.settings; } }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.border; }

        // Main area
        VerticalLayout {
            // "X is controlling / viewing this device" with Stop (R5.4).
            for a in root.activities: Rectangle {
                height: a.incoming ? 44px : 0px;
                visible: a.incoming;
                background: Theme.warn-bg;
                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 10px;
                    Text { text: @tr("{} is using {} on this device.", a.device, a.label); color: Theme.text; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                    Btn { text: @tr("Stop"); kind: 2; y: (parent.height - self.height) / 2; clicked => { root.stop-activity(a.id); } }
                }
            }
            // Ports open on the LAN (R13.6), on every page.
            TunnelLanBanner { }
            if root.toast != "": Rectangle {
                height: 36px;
                background: Theme.allow-bg;
                Text { text: root.toast; color: Theme.allow-fg; font-weight: 600; }
            }

            ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    padding: 22px;
                    spacing: 14px;
                    alignment: start;

                    // ------------------------------------------------ This device
                    if root.page == Page.this-device: VerticalLayout {
                        spacing: 14px;
                        Rectangle {
                            height: 110px;
                            border-radius: 12px;
                            background: Theme.header;
                            HorizontalLayout {
                                padding: 20px;
                                spacing: 16px;
                                Rectangle {
                                    width: 56px; height: 56px; border-radius: 12px; background: #ffffff.with-alpha(0.12);
                                    y: (parent.height - self.height) / 2;
                                    Icon { source: @image-url("icons/laptop.svg"); tint: Theme.on-header; width: 28px; height: 28px; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text { text: root.me-name; font-size: 24px; font-weight: 600; color: Theme.on-header; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Chip { text: root.me-platform; bg: #ffffff.with-alpha(0.14); fg: Theme.on-header; }
                                        Chip { text: @tr("This device"); bg: #ffffff.with-alpha(0.14); fg: Theme.on-header; }
                                        if root.me-address != "": Chip { text: root.me-address; bg: #ffffff.with-alpha(0.14); fg: Theme.on-header; }
                                    }
                                }
                                if root.me-battery != "": VerticalLayout {
                                    alignment: center;
                                    Text { text: root.me-battery; font-size: 28px; font-weight: 700; color: Theme.on-header; horizontal-alignment: right; }
                                    Text { text: @tr("battery"); font-size: Theme.font-small; color: Theme.on-header; horizontal-alignment: right; }
                                }
                            }
                        }
                        SectionTitle { text: @tr("Permissions for other devices"); }
                        Muted { text: @tr("Applies to every device paired with {}. Allow: starts right away. Always Ask: you confirm here first. Deny: the feature is off on other devices.", root.me-name); }
                        for p in root.permissions: PermRow {
                            item: p;
                            picked(m) => {
                                if (p.local-only && m == 0 && p.mode != 0) {
                                    root.confirm-cap = p.cap;
                                } else {
                                    root.set-permission(p.cap, m, false);
                                }
                            }
                        }
                        TunnelHostSection { }
                    }

                    // ------------------------------------------------ Paired device
                    if root.page == Page.peer: VerticalLayout {
                        spacing: 14px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            if root.peer.status == "connected": Btn { text: @tr("Disconnect"); clicked => { root.disconnect(root.peer.id); } }
                            if root.peer.status != "connected": Btn { text: @tr("Reconnect"); kind: 0; enabled: root.peer.status == "disconnected"; clicked => { root.reconnect(root.peer.id); } }
                            Btn { text: @tr("Forget device"); kind: 2; clicked => { root.confirm-forget = root.peer.id; } }
                        }
                        Rectangle {
                            height: 110px;
                            border-radius: 12px;
                            background: Theme.header;
                            HorizontalLayout {
                                padding: 20px;
                                spacing: 16px;
                                Rectangle {
                                    width: 56px; height: 56px; border-radius: 12px; background: #ffffff.with-alpha(0.12);
                                    y: (parent.height - self.height) / 2;
                                    Icon { source: root.peer.platform == "Android" ? @image-url("icons/phone.svg") : @image-url("icons/laptop.svg"); tint: Theme.on-header; width: 28px; height: 28px; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    Text { text: root.peer.name; font-size: 24px; font-weight: 600; color: Theme.on-header; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;
                                        Chip { text: root.peer.platform; bg: #ffffff.with-alpha(0.14); fg: Theme.on-header; }
                                        Chip {
                                            text: root.peer.status == "connected" ? root.peer.path + " · " + root.peer.rtt : root.peer.status-text;
                                            bg: root.peer.status == "connected" ? Theme.allow-bg : #ffffff.with-alpha(0.14);
                                            fg: root.peer.status == "connected" ? Theme.allow-fg : Theme.on-header;
                                        }
                                        if root.peer.address != "": Chip { text: root.peer.address; bg: #ffffff.with-alpha(0.14); fg: Theme.on-header; }
                                    }
                                }
                                if root.peer.battery != "": VerticalLayout {
                                    alignment: center;
                                    Text { text: root.peer.battery; font-size: 28px; font-weight: 700; color: Theme.on-header; horizontal-alignment: right; }
                                    Text { text: @tr("battery"); font-size: Theme.font-small; color: Theme.on-header; horizontal-alignment: right; }
                                }
                            }
                        }
                        if root.peer.status != "connected": Card {
                            height: 70px;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 4px;
                                Text { text: root.peer.status == "disconnected" ? @tr("Disconnected") : @tr("{} is offline", root.peer.name); font-weight: 600; color: Theme.text; }
                                Muted { text: root.peer.status == "disconnected" ? @tr("Press Reconnect on either device to connect again. The pairing is kept.") : @tr("UrDevice connects on its own when {} is on the same network.", root.peer.name); }
                            }
                        }
                        SectionTitle { text: @tr("Features on {}", root.peer.name); }
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: start;
                            Chip { text: @tr("Allow"); bg: Theme.allow-bg; fg: Theme.allow-fg; }
                            Chip { text: @tr("Always Ask: {} confirms first", root.peer.name); bg: Theme.ask-bg; fg: Theme.ask-fg; }
                            Chip { text: @tr("Deny: turned off by {}", root.peer.name); bg: Theme.deny-bg; fg: Theme.deny-fg; }
                        }
                        if root.peer.status == "connected": GridLayout {
                            spacing: 10px;
                            for t[i] in root.tiles: Rectangle {
                                row: i / 3;
                                col: mod(i, 3);
                                height: 92px;
                                border-radius: Theme.radius;
                                border-width: 1px;
                                border-color: Theme.border;
                                background: t.mode == 2 ? Theme.surface-2 : tile-ta.has-hover ? Theme.surface-2 : Theme.surface;
                                opacity: t.mode == 2 ? 0.6 : 1;
                                tile-ta := TouchArea {
                                    enabled: t.mode != 2;
                                    mouse-cursor: t.mode == 2 ? default : pointer;
                                    clicked => {
                                        if (t.view) {
                                            root.feature = t.feature;
                                            root.feature-tile = t.key;
                                            root.open-feature(root.peer.id, t.feature, t.key);
                                            root.page = Page.feature;
                                        } else {
                                            root.request(root.peer.id, t.cap);
                                        }
                                    }
                                }
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    HorizontalLayout {
                                        IconBox { icon: t.icon; size: 32px; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Rectangle {
                                            width: 28px; height: 28px; border-radius: 14px;
                                            background: gear-ta.has-hover ? Theme.border : transparent;
                                            Icon { source: @image-url("icons/gear.svg"); width: 14px; height: 14px; tint: Theme.muted; }
                                            gear-ta := TouchArea { mouse-cursor: pointer; clicked => { root.page = Page.this-device; } }
                                        }
                                    }
                                    Text { text: t.label; font-weight: 600; color: Theme.text; }
                                    Text {
                                        text: t.mode == 0 ? @tr("Ready") : t.mode == 1 ? @tr("Needs approval") : @tr("Turned off by {}", root.peer.name);
                                        font-size: Theme.font-small;
                                        color: t.mode == 0 ? Theme.allow-fg : t.mode == 1 ? Theme.ask-fg : Theme.muted;
                                    }
                                }
                            }
                        }
                        for a in root.activities: Card {
                            height: a.incoming ? 0 : 52px;
                            visible: !a.incoming;
                            HorizontalLayout {
                                padding: 10px;
                                Text { text: @tr("You are using {} on {}", a.label, a.device); vertical-alignment: center; color: Theme.text; horizontal-stretch: 1; }
                                Btn { text: @tr("End"); clicked => { root.stop-activity(a.id); } }
                            }
                        }
                        Muted { text: @tr("Device ID: {}", root.peer.fingerprint); }
                    }

                    // ------------------------------------------------ Feature view
                    if root.page == Page.feature: VerticalLayout {
                        spacing: 14px;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Btn { text: @tr("Back"); clicked => { root.page = Page.peer; } }
                            Text { text: Labels.tile-label(root.feature-tile) + " · " + root.peer.name; font-size: 22px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                        }
                        FeatureView { feature: root.feature; tile: root.feature-tile; peer-name: root.peer.name; }
                    }

                    // ------------------------------------------------ Add device
                    if root.page == Page.pair: VerticalLayout {
                        spacing: 14px;
                        Text { text: @tr("Add Device"); font-size: 22px; font-weight: 700; color: Theme.text; }
                        Card {
                            VerticalLayout {
                                padding: 18px;
                                PairBody {
                                    qr: root.qr;
                                    countdown: root.qr-countdown;
                                    locked: root.pair-locked;
                                    has-camera: root.has-camera;
                                    nearby: root.nearby;
                                    codes: root.codes;
                                    scan => { root.scan-qr(); }
                                    pair-nearby(k) => { root.pair-nearby(k); }
                                    confirm-code(k, ok) => { root.confirm-code(k, ok); }
                                }
                            }
                        }
                    }

                    // ------------------------------------------------ Settings
                    if root.page == Page.settings: VerticalLayout {
                        spacing: 12px;
                        Text { text: @tr("Settings"); font-size: 22px; font-weight: 700; color: Theme.text; }
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                Text { text: @tr("Device name"); font-weight: 600; color: Theme.text; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    name-edit := LineEdit { text: root.me-name; }
                                    Btn { text: @tr("Save"); clicked => { root.set-name(name-edit.text); } }
                                }
                                Text { text: @tr("Device ID"); font-weight: 600; color: Theme.text; }
                                Text { text: root.me-fingerprint; font-family: "monospace"; color: Theme.muted; }
                            }
                        }
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 14px;
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        Text { text: @tr("Hidden mode"); font-weight: 600; color: Theme.text; }
                                        Muted { text: @tr("Stop announcing this device. Paired devices can still connect; new devices can't pair."); }
                                    }
                                    Toggle { checked: root.me-hidden; toggled(v) => { root.set-hidden(v); } y: (parent.height - self.height) / 2; }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        Text { text: @tr("Start at login"); font-weight: 600; color: Theme.text; }
                                        Muted { text: @tr("Open UrDevice in the tray when you sign in."); }
                                    }
                                    Toggle { checked: root.autostart; toggled(v) => { root.set-autostart(v); } y: (parent.height - self.height) / 2; }
                                }
                                // clipboard (#16, R7.6)
                                HorizontalLayout {
                                    spacing: 10px;
                                    VerticalLayout {
                                        Text { text: @tr("Pause clipboard on all devices"); font-weight: 600; color: Theme.text; }
                                        Muted { text: @tr("Nothing you copy is sent, and nothing from other devices is written to your clipboard. Switch it off per device on its page."); }
                                    }
                                    Toggle { checked: ClipboardFeature.paused; toggled(v) => { ClipboardFeature.set-paused(v); } y: (parent.height - self.height) / 2; }
                                }
                                HorizontalLayout {
                                    VerticalLayout {
                                        Text { text: @tr("Language"); font-weight: 600; color: Theme.text; }
                                        Muted { text: @tr("English. More languages come later."); }
                                    }
                                }
                            }
                        }
                        // Files (#17): the download folder (R8.6).
                        FilesSettings { }
                        Card {
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                Text { text: @tr("Your data"); font-weight: 600; color: Theme.text; }
                                Muted { text: @tr("Stored in {}", root.data-path); }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: start;
                                    Btn { text: @tr("Activity log"); clicked => { root.show-log(); root.page = Page.log; } }
                                    Btn { text: @tr("Export data"); clicked => { root.export-data(); } }
                                    Btn { text: @tr("Reset identity"); kind: 2; clicked => { root.confirm-reset = true; } }
                                    Btn { text: @tr("Delete all data"); kind: 2; clicked => { root.confirm-delete = true; } }
                                }
                            }
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 12px;
                            Muted { text: @tr("UrDevice {}", root.core-version); vertical-alignment: center; }
                            AboutSlint { max-height: 60px; }
                        }
                    }

                    // ------------------------------------------------ Activity log
                    if root.page == Page.log: VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 8px;
                            Btn { text: @tr("Back"); clicked => { root.page = Page.settings; } }
                            Text { text: @tr("Activity log"); font-size: 22px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                        }
                        Muted { text: @tr("Requests from other devices in the last 30 days. Content is never recorded."); }
                        if root.log.length == 0: Muted { text: @tr("Nothing yet."); }
                        for e in root.log: Card {
                            height: 44px;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 12px;
                                Text { text: e.time; color: Theme.muted; width: 150px; vertical-alignment: center; }
                                Text { text: e.device; color: Theme.text; font-weight: 600; width: 160px; vertical-alignment: center; overflow: elide; }
                                Text { text: e.label; color: Theme.text; horizontal-stretch: 1; vertical-alignment: center; }
                                Chip {
                                    y: (parent.height - self.height) / 2;
                                    text: e.decision-label;
                                    bg: e.decision == "allowed" ? Theme.allow-bg : Theme.deny-bg;
                                    fg: e.decision == "allowed" ? Theme.allow-fg : Theme.deny-fg;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ---------------------------------------------------------------- Dialogs
    if root.confirm-cap != "" || root.confirm-forget != "" || root.confirm-reset || root.confirm-delete: Rectangle {
        background: #000000.with-alpha(0.45);
        TouchArea { }
        Rectangle {
            width: 440px;
            height: 220px;
            border-radius: 14px;
            background: Theme.surface;
            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    font-size: Theme.font-title;
                    font-weight: 700;
                    color: Theme.text;
                    wrap: word-wrap;
                    text: root.confirm-cap == "term.v1" ? @tr("Allow remote terminal?")
                        : root.confirm-cap != "" ? @tr("Allow file changes?")
                        : root.confirm-forget != "" ? @tr("Forget this device?")
                        : root.confirm-reset ? @tr("Reset this device's identity?")
                        : @tr("Delete all UrDevice data?");
                }
                Muted {
                    text: root.confirm-cap == "term.v1" ? @tr("Every paired device gets full control of this device's shell, with no prompt. Only allow this if you trust all of them.")
                        : root.confirm-cap != "" ? @tr("Every paired device can upload, rename, and delete files here, with no prompt. Only allow this if you trust all of them.")
                        : root.confirm-forget != "" ? @tr("The pairing is deleted on both devices. To connect again, pair again.")
                        : root.confirm-reset ? @tr("A new key is made and every paired device is removed. Each one must pair again.")
                        : @tr("Pairings, permissions, the activity log, and this device's key are deleted.");
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;
                    Btn {
                        text: @tr("Cancel");
                        clicked => { root.confirm-cap = ""; root.confirm-forget = ""; root.confirm-reset = false; root.confirm-delete = false; }
                    }
                    Btn {
                        kind: 2;
                        text: root.confirm-cap != "" ? @tr("Allow") : root.confirm-forget != "" ? @tr("Forget device") : root.confirm-reset ? @tr("Reset identity") : @tr("Delete all data");
                        clicked => {
                            if (root.confirm-cap != "") {
                                root.set-permission(root.confirm-cap, 0, true);
                            } else if (root.confirm-forget != "") {
                                root.forget(root.confirm-forget);
                                root.page = Page.this-device;
                            } else if (root.confirm-reset) {
                                root.reset-identity();
                            } else {
                                root.delete-all();
                            }
                            root.confirm-cap = ""; root.confirm-forget = ""; root.confirm-reset = false; root.confirm-delete = false;
                        }
                    }
                }
            }
        }
    }
}
