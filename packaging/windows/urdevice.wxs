<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows installer for UrDevice (WiX v5).

  Build:
    wix extension add -g WixToolset.Firewall.wixext/5.0.2
    wix build -arch x64 -ext WixToolset.Firewall.wixext -d Version=0.1.0 -d BinDir=target\release \
      packaging\windows\urdevice.wxs -o urdevice.msi

  The firewall exception is the fix for issue #59: Windows blocks inbound UDP to
  an unknown program on Private networks, so a paired phone could not reach the
  desktop. The rule is program-based (urdevice.exe, UDP, any local port) so it
  also covers the fallback port the app picks when 47811 is taken, and mDNS.
  It applies to the Private profile only; Public networks stay closed.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:fw="http://wixtoolset.org/schemas/v4/wxs/firewall">
  <Package Name="UrDevice"
           Manufacturer="UrDevice"
           Version="$(Version)"
           UpgradeCode="6f1d6a52-8c3e-4b7e-9d0a-3b2f5e8a7c14"
           Scope="perMachine">
    <MediaTemplate EmbedCab="yes" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of UrDevice is already installed." />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="UrDevice">
        <Component Id="MainExecutable" Guid="*">
          <File Id="UrDeviceExe" Source="$(BinDir)\urdevice.exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="UrDevice" WorkingDirectory="INSTALLFOLDER" />
          </File>
          <fw:FirewallException Id="UrDeviceFirewallUdp"
                                Name="UrDevice (UDP, Private networks)"
                                Description="Lets paired devices on your private network reach UrDevice (QUIC and mDNS discovery)."
                                Program="[#UrDeviceExe]"
                                Protocol="udp"
                                Profile="private"
                                Scope="any"
                                IgnoreFailure="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="UrDevice" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>
  </Package>
</Wix>
